# Copie este arquivo para "%LOCALAPPDATA%\Nico\.env" (sem ".example") e
# preencha com suas próprias chaves gratuitas - NÃO dentro da pasta do
# projeto: ela fica no OneDrive e sincroniza na nuvem, e esse arquivo guarda
# segredos (chaves de API, o link do Google Calendar). Fora do OneDrive,
# config.py ainda cai de volta pra um ".env" local aqui ao lado, se existir,
# só por compatibilidade com instalações antigas.
#
# Nenhuma chave é obrigatória: se ficarem vazias, o Nico simplesmente usa
# só o modelo local (Ollama) e pula a busca na web.
#
# Groq   (modelo de nuvem maior, reforço p/ perguntas difíceis - grátis):
#   1. Crie uma conta em https://console.groq.com
#   2. Vá em "API Keys" e gere uma nova chave
GROQ_API_KEY=

# Google Gemini (segundo modelo de reforço, usado se o Groq falhar - grátis):
#   1. Entre com sua conta Google em https://aistudio.google.com/apikey
#   2. Clique em "Create API key"
GEMINI_API_KEY=

# Kimi / Moonshot AI (terceiro reforço, usado se Groq e Gemini falharem):
#   1. Crie uma conta em https://platform.moonshot.ai
#   2. Vá em "API Keys" e gere uma nova chave
KIMI_API_KEY=

# Tavily (busca real na internet p/ perguntas sobre hoje/atual - free tier
# de ~1000 buscas/mês, sem cartão de crédito):
#   1. Crie uma conta em https://app.tavily.com
#   2. Copie a chave no painel (dashboard)
TAVILY_API_KEY=

# Pasta local sincronizada do Google Drive onde a rotina "Nico Research"
# (tarefa agendada no Claude) salva os resumos diários. Só funciona depois
# de instalar o Google Drive Desktop (drive.google.com/drive/download).
# Exemplo no Windows: G:\Meu Drive\Nico Research
DOCUMENTS_FOLDER=

# Pasta de anotações manuais (opcional) - solte arquivos .txt, .md, .docx ou .pdf
# com qualquer coisa que você queira que o Nico saiba.
# Exemplo: G:\Meu Drive\Nico Notes
NOTES_FOLDER=

# Cidade padrão para "what's the weather" (opcional). Se deixar vazio, o
# Nico descobre sua cidade atual automaticamente pelo IP (sem cadastro).
# Exemplo: Sao Paulo
WEATHER_CITY=

# "Modos de trabalho" - "modo trabalho", "modo estudos" etc. abrem de uma
# vez todos os sites/apps listados (separados por vírgula). Cada item pode
# ser um nome conhecido (ver APP_SHORTCUTS/SITE_SHORTCUTS em config.py,
# ex.: "gmail", "notepad") ou uma URL qualquer. O nome depois de
# "WORK_MODE_" (em minúsculas) é o que você fala depois de "modo".
# Exemplo:
# WORK_MODE_TRABALHO=gmail,github,https://meusite.com
WORK_MODE_TRABALHO=

# A wake word local e a detecção de duas palmas usam Vosk e o modelo
# português guardado em %LOCALAPPDATA%\Nico\models. Não exigem conta nem chave.

# Google Calendar (opcional, somente-leitura) - "minha agenda"/"o que eu
# tenho hoje"/"bom dia" passam a incluir seus eventos de verdade, não só
# os lembretes que você pediu pro Nico guardar.
#   1. No Google Calendar (web), vá em Configurações -> sua agenda, na
#      coluna da esquerda.
#   2. Em "Integrar agenda", copie o "Endereço secreto no formato iCal".
#   3. Cole aqui. Esse link é somente-leitura, mas quem tiver ele consegue
#      ver sua agenda inteira - trate como um segredo (nunca compartilhe,
#      nunca comite).
GOOGLE_CALENDAR_ICS_URL=
